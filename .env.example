# Copy to .env and replace placeholders with local values. Never commit secrets.
TEMP_FOLDER=./_temp
URL_CONNECTION_MONGODB=mongodb://localhost:27017
DATABASE_NAME=aprovia_db
ASSISTANT_COLLECTION=assistant

# Public API aliases stay fixed: llama3 (English) and qwen2-math (Mathematics).
# These variables select the exact installed Ollama model. Set llama3.2:3b only
# deliberately; it is not treated as equivalent to llama3 by the application.
OLLAMA_ENGLISH_MODEL=llama3
OLLAMA_MATH_MODEL=qwen2-math
